{
  "name": "RAWB MagicSpells configuration",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/home/pelican/dev-main",
  "remoteUser": "pelican",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.associations": {
          "*.yml": "yaml",
          "*.yaml": "yaml"
        },
        "editor.formatOnSave": true
      }
    }
  }
}
